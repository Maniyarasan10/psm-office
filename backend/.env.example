# Copy this file to .env and fill in your real values.
# In production, set these as real environment variables on your host
# (Render/Railway/Heroku/Docker/etc.) and NEVER commit the .env file.
#
# ---------------------------------------------------------------------------
# SECURITY: ROTATE EXPOSED SECRETS
# If a real .env or a Google/Firebase service-account JSON was ever committed
# or shared, treat those values as compromised and rotate them now:
#   1. ADMIN_PASSWORD  - change it and restart the backend.
#   2. SMTP_PASSWORD   - revoke the old Gmail/Workspace App Password and
#                        generate a new one.
#   3. Firebase keys   - in Google Cloud Console delete the old service-account
#                        key and download a fresh JSON, then point
#                        FIREBASE_CREDENTIALS at it (see below).
#   4. AUTH_SECRET     - generate a fresh value (all existing tokens become
#                        invalid, which is expected).
# ---------------------------------------------------------------------------

# MongoDB connection string.
# Examples:
#   local:        mongodb://127.0.0.1:27017/
#   MongoDB Atlas: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/
MONGO_URI=mongodb://127.0.0.1:27017/

# Database name shared by the admin panel and the mobile applications.
MONGO_DB_NAME=psm_office_manager

# Admin login credentials used by /api/auth/admin-login.
# Use a long, random password. The server fails closed (HTTP 503) if
# ADMIN_PASSWORD is left unset.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# OPTIONAL: instead of a plaintext ADMIN_PASSWORD, set a Werkzeug password
# hash (takes precedence when set). Generate with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password'))"
# ADMIN_PASSWORD_HASH=

# Optional path for the admin photo shown in the UI.
ADMIN_PHOTO_PATH=/fin.png

# Comma-separated browser origins allowed to call the API.
# MUST be set to an explicit allowlist in production (wildcards are rejected
# there), e.g.:
#   CORS_ORIGINS=https://admin.problemsolvingmind.com,https://m.problemsolvingmind.com
# Leave "*" only for local development.
CORS_ORIGINS=*

# Secret used to sign auth tokens (HMAC-SHA256). REQUIRED in production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# When "1", protected endpoints require a valid bearer token.
# Set to "1" in production. Keep "0" only while clients are being rolled out.
AUTH_REQUIRED=0

# How long an issued access token stays valid, in seconds (default 7 days).
AUTH_TOKEN_TTL=604800

# Lifetime of mobile refresh tokens, in seconds (default 90 days).
AUTH_REFRESH_TOKEN_TTL=7776000

# Set to "production" to enforce production hardening: fail fast on insecure
# configuration, disable debug, require AUTH_SECRET, restrict CORS and require
# AUTH_REQUIRED=1.
FLASK_ENV=development
# Set to "1" to enable Flask debug mode (development only; never in production).
FLASK_DEBUG=0

# Force HTTPS-only responses (adds HSTS). Enable when served behind TLS.
FORCE_HTTPS=0

# Externally reachable base URL of this API. Used to build absolute URLs.
# PUBLIC_BASE_URL=https://api.problemsolvingmind.com

# Google / Firebase service-account credentials used for FCM.
# Option A (recommended for env-var-only platforms): inline the JSON, either
# raw or base64-encoded, in a single env var:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# FIREBASE_CREDENTIALS_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...
# Option B: keep the JSON in a file OUT of source control and point at it:
# FIREBASE_CREDENTIALS=/etc/secrets/firebase-admin.json

# Minimum length enforced for user-chosen passwords (default 8).
MIN_PASSWORD_LENGTH=8

# Maximum accepted request body size, in bytes (default 50 MB).
MAX_CONTENT_LENGTH=52428800

# Comma-separated allowlist of uploadable document extensions.
ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,rtf,odt,ods,odp,jpg,jpeg,png,gif,webp,bmp,zip

# Set to "0" to disable the security response headers (not recommended).
SECURITY_HEADERS=1

# Set to "1" ONLY when the app runs behind a trusted reverse proxy, so the real
# client IP is read from X-Forwarded-For for rate limiting. Leave "0" otherwise
# (otherwise clients can spoof the header).
TRUST_PROXY=0

# Set to "1" to actually send Expo push notifications (best-effort).
ENABLE_PUSH=0

# Email (SMTP) used for new-hire credentials and password-reset OTPs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=PSM Office
SMTP_USE_TLS=1
SMTP_USE_SSL=0
PASSWORD_OTP_TTL_SECONDS=600

# Bind host/port for the built-in dev server (gunicorn/waitress override this).
HOST=0.0.0.0
PORT=5000
