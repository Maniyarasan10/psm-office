# PSM Office Manager - production environment for the server.
#
# Install as:  sudo install -m 600 -o root -g psm deploy/psm-office.env.example \
#                   /etc/psm-office/psm-office.env
# then edit the values below and restart the service.
#
# systemd parses this file with shell-like quoting rules: wrap any value that
# contains spaces, #, or $ in single quotes.

# ---------------------------------------------------------------------------
# MongoDB Atlas (M0 free tier)
# ---------------------------------------------------------------------------
# Keep the credentials percent-encoded if the password contains @ : / ? # [ ] %
MONGO_URI='mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority'
MONGO_DB_NAME=psm_office_manager
# M0 caps concurrent connections per cluster - keep this small.
MONGO_MAX_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Cloudinary - all media lives here, never in MongoDB
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=psm
CLOUDINARY_SECURE=1
CLOUDINARY_MAX_BYTES=26214400
CLOUDINARY_IMAGE_MAX_WIDTH=1200
CLOUDINARY_EAGER_IMAGES=0
# Refuse to start if the cloud credentials are missing (production should).
REQUIRE_CLOUDINARY=1

# ---------------------------------------------------------------------------
# Authentication - the backend refuses to start in production without these
# ---------------------------------------------------------------------------
# Admin login for /api/auth/admin-login. Use ADMIN_PASSWORD_HASH instead if
# you prefer not to keep a plaintext password on the server:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=
# HMAC key for the access/refresh tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every issued token.
AUTH_SECRET=
AUTH_REQUIRED=1
AUTH_TOKEN_TTL=604800
AUTH_REFRESH_TOKEN_TTL=7776000
MIN_PASSWORD_LENGTH=8

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
FLASK_ENV=production
FLASK_DEBUG=0
# Only enable TRUST_PROXY when the app really sits behind a reverse proxy that
# overwrites X-Forwarded-For (Caddy does).
TRUST_PROXY=1
FORCE_HTTPS=1
SECURITY_HEADERS=1
PUBLIC_BASE_URL=https://api.problemsolvingmind.com
# Explicit allowlist - a wildcard is rejected in production.
CORS_ORIGINS=https://admin.problemsolvingmind.com,https://m.problemsolvingmind.com,https://problemsolvingmind.com
MAX_CONTENT_LENGTH=52428800

# ---------------------------------------------------------------------------
# Database housekeeping (MongoDB TTL indexes)
# ---------------------------------------------------------------------------
NOTIFICATION_TTL_DAYS=90
ACTIVITY_LOG_TTL_DAYS=180
LEGACY_PHOTO_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Email (SMTP) for new-hire credentials and password-reset OTPs
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=PSM Office
SMTP_USE_TLS=1
SMTP_USE_SSL=0
PASSWORD_OTP_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# Push notifications (Expo). Best effort; needs network egress to exp.expo.com.
# ---------------------------------------------------------------------------
ENABLE_PUSH=0

# ---------------------------------------------------------------------------
# Firebase / FCM. Either inline the JSON or point at a file on disk.
# ---------------------------------------------------------------------------
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# FIREBASE_CREDENTIALS=/etc/psm-office/firebase-admin.json

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,rtf,odt,ods,odp,jpg,jpeg,png,gif,webp,bmp,zip
