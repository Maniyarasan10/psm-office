[Unit]
Description=PSM Office Manager API (Flask + PyMongo + Cloudinary)
Documentation=https://github.com/Maniyarasan10/psm-office
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=psm
Group=psm
WorkingDirectory=/opt/psm-office/backend
EnvironmentFile=/etc/psm-office/psm-office.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PORT=8000

# One worker process on purpose: backend/realtime.py keeps the WebSocket
# registry in memory, so a second worker would hold a disjoint subset of the
# connections and push events would only reach some clients.
ExecStart=/opt/psm-office/venv/bin/gunicorn \
    --bind 127.0.0.1:8000 \
    --workers 1 \
    --threads 8 \
    --worker-class gthread \
    --timeout 120 \
    --graceful-timeout 30 \
    --keep-alive 5 \
    --access-logfile - \
    --error-logfile - \
    wsgi:app

Restart=always
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM

# The e2-micro box has 1 GB of RAM; cap the app so a runaway report or
# upload cannot take the whole machine down with it.
MemoryAccounting=yes
MemoryMax=700M
MemoryHigh=600M

# Hardening.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/opt/psm-office/backend/uploads /opt/psm-office/backend/backups

StandardOutput=journal
StandardError=journal
SyslogIdentifier=psm-office

[Install]
WantedBy=multi-user.target
